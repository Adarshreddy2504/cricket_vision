# CricketVision environment example.
#
# Copy this file to `.env` in the repository root. `.env` is ignored by git;
# `.env.example` is the documented, safe template. Shell-exported variables win
# over values in `.env`.
#
# Relative paths are resolved against the repository root, not the directory
# you happen to start the server from.

# ── HTTP server ──────────────────────────────────────────────────────────────
# Native server bind address. Inside Docker the image binds 0.0.0.0:8000.
CRICKET_HOST=127.0.0.1
CRICKET_PORT=8000

# Comma-separated browser origins allowed to call the API. Same-origin requests
# through the Docker frontend do not need CORS, but these cover direct access
# and the native Vite server.
CRICKET_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# Host ports used by compose.yaml. These are not read by the Python app.
CRICKET_API_PORT=8000
CRICKET_FRONTEND_PORT=8080

# Docker-specific wheel selection. Leave the CPU index for the default image;
# compose.gpu.yaml overrides it with the CUDA 12.6 index.
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
TORCH_VERSION=2.13.0
TORCHVISION_VERSION=0.28.0

# ── Generated files ──────────────────────────────────────────────────────────
# Uploads, runs, status/result documents and clips live here. Keep it outside
# version control (the default `./data` is already ignored).
CRICKET_DATA_DIR=./data

# Keep the original uploaded video after an analysis. Off by default: only the
# generated clips are retained.
CRICKET_KEEP_SOURCE=false

# Run the pipeline synchronously inside the upload request. Useful for local
# debugging; leave false for the documented 202 + polling behaviour.
CRICKET_RUN_INLINE=false

# Maximum upload body size in bytes (2 GiB by default).
CRICKET_MAX_UPLOAD_BYTES=2147483648

# Candidate delivery clip window, in frames. The window length is capped so a
# single long track cannot create an unbounded clip.
CRICKET_CLIP_PRE_ROLL=10
CRICKET_CLIP_POST_ROLL=10
CRICKET_CLIP_MAX_FRAMES=600

# A processing safety net, not a target. Checked between measured progress
# updates, so one blocking model call can overrun it before the next check.
CRICKET_MAX_JOB_SECONDS=3600

# Abandoned upload fragments older than this are removed at startup.
CRICKET_TEMP_MAX_AGE_SECONDS=86400

# ── Model locations ─────────────────────────────────────────────────────────
# All four default filenames are looked up here:
#   ball_detector.pt
#   pitch_detect.pt
#   pitch_seg_yolo11s.pt
#   shot_classifier.ckpt
CRICKET_MODELS_DIR=./backend/models

# Per-model overrides. Leave commented to use CRICKET_MODELS_DIR. A relative
# path is resolved against the repository root. Nothing is downloaded.
# CRICKET_BALL_MODEL=./backend/models/ball_detector.pt
# CRICKET_PITCH_BOX_MODEL=./backend/models/pitch_detect.pt
# CRICKET_PITCH_SEG_MODEL=./backend/models/pitch_seg_yolo11s.pt
# CRICKET_SHOT_MODEL=./backend/models/shot_classifier.ckpt

# Optional checksum gate for the shot checkpoint. Set this to verify an
# installation; it is not enabled unless you provide a value.
# CRICKET_SHOT_MODEL_MD5=2974efdcf449c8447bef107d94633217

# "auto" uses CUDA when available, CPU otherwise. Any other value is passed to
# ultralytics/torch verbatim (for example "cpu", "cuda", "cuda:1").
CRICKET_BALL_DEVICE=auto
CRICKET_PITCH_DEVICE=auto
CRICKET_SHOT_DEVICE=auto

# ── Ball detector and tracker ───────────────────────────────────────────────
# A box must reach this confidence to START a track.
CRICKET_BALL_CONF=0.30

# A box may go this low only to EXTEND an already-live track, and it must also
# pass the Kalman gate. It never starts a track.
CRICKET_BALL_ASSOC_CONF=0.10

# Inference resize, in pixels. Answers are rescaled to source pixels.
CRICKET_BALL_RESIZE_W=640
CRICKET_BALL_RESIZE_H=360

# Bounding-box diagonal bounds in the resized frame.
CRICKET_BALL_MIN_DIAG=4
CRICKET_BALL_MAX_DIAG=80

# Kalman association gate and coast window.
CRICKET_BALL_GATE_RADIUS=120
CRICKET_BALL_MAX_MISSED=8
CRICKET_BALL_MAX_TRAIL=120

# Real detections needed before a track is reported as a flight.
CRICKET_BALL_MIN_TRACK_DETECTIONS=3

# ── Pitch detectors ─────────────────────────────────────────────────────────
CRICKET_PITCH_CONF=0.25
CRICKET_PITCH_IMGSZ=640
CRICKET_PITCH_MIN_AREA_FRACTION=0.01
CRICKET_PITCH_MAX_AREA_FRACTION=0.25
CRICKET_PITCH_MIN_ASPECT_RATIO=1.0
CRICKET_PITCH_MAX_ASPECT_RATIO=6.0
