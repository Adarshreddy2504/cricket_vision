# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
sdist/
wheels/

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/

# Type-checker / linter caches
*.tsbuildinfo

# ── Frontend dependencies and build output ─────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/.vite/
frontend/.env
frontend/.env.local

# ── Secrets and local overrides ───────────────────────────────────────────────
# Credentials (e.g. model access keys) live here and are never committed.
.env
.env.*
!.env.example

# ── Runtime output ────────────────────────────────────────────────────────────
# Everything below is GENERATED by an analysis and can be rebuilt from the
# uploaded footage. Never commit it.
data/runs/
data/uploads/
data/samples/
data/tmp/
logs/
*.log

# ── Model weights ─────────────────────────────────────────────────────────────
# Model weights are NOT tracked in git. See docs/TRACKING.md, docs/PITCH.md and
# docs/SHOTS.md for how to obtain them and how to point the loaders at a local
# copy.
*.pt
*.pth
*.ckpt
*.onnx
*.engine
*.tflite
*.h5
*.weights

# ── Footage, datasets and generated media ─────────────────────────────────────
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.gif
data/datasets/

# ── Editors / OS ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Local agent / CI settings ────────────────────────────────────────────────
.claude/settings.local.json
