# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
sdist/
wheels/

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/

# Type-checker / linter caches
*.tsbuildinfo

# ── Frontend dependencies and build output ─────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/.vite/
frontend/.env
frontend/.env.local

# ── Secrets and local overrides ───────────────────────────────────────────────
# Credentials (e.g. model access keys) live here and are never committed.
.env
.env.*
!.env.example

# ── Runtime output ────────────────────────────────────────────────────────────
# Everything below is GENERATED by an analysis and can be rebuilt from the
# uploaded footage. Never commit it.
data/runs/
data/uploads/
data/samples/
data/tmp/
logs/
*.log

# ── Model weights ─────────────────────────────────────────────────────────────
# Model weights are ignored by default so local checkpoints cannot be committed
# accidentally. The four supplied CricketVision checkpoints below are explicit
# exceptions and are tracked for a fresh-clone install.
*.pt
*.pth
*.ckpt
*.onnx
*.engine
*.tflite
*.h5
*.weights

# The four supplied CricketVision checkpoints are intentionally tracked so a
# fresh clone can analyse footage without a separate weights download. Nothing
# else matching the patterns above is tracked. Docker images still mount this
# directory at runtime instead of copying it into the image.
!backend/models/ball_detector.pt
!backend/models/pitch_detect.pt
!backend/models/pitch_seg_yolo11s.pt
!backend/models/shot_classifier.ckpt

# ── Footage, datasets and generated media ─────────────────────────────────────
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.gif
data/datasets/

# ── Editors / OS ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Local agent / CI settings ────────────────────────────────────────────────
.claude/settings.local.json
